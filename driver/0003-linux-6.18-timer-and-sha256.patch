diff --git a/osdep_service_linux.h b/osdep_service_linux.h
index f7f7682..ba25fc0 100644
--- a/osdep_service_linux.h
+++ b/osdep_service_linux.h
@@ -293,7 +293,11 @@ __inline static void _set_timer(struct timer_list *ptimer, u32 delay_time)
 
 __inline static void _cancel_timer(struct timer_list *ptimer, u8 *bcancelled)
 {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+	timer_delete_sync(ptimer);
+#else
 	del_timer_sync(ptimer);
+#endif
 	*bcancelled = 1;
 }
 
