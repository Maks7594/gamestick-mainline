# Architecture and boot
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_SUNXI=y
CONFIG_MACH_SUN8I=y
CONFIG_SMP=y
CONFIG_HIGHMEM=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_AEABI=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_FORCE=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=n
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=n
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=n
CONFIG_CMDLINE_BOOL=y
# MMC works now, so mount the real root directly and drop the built-in
# initramfs. diagnostic-init.c only ever existed because there was no console:
# it probed for a root device and signalled findings through the LED. Both jobs
# are now done properly by the kernel and by fbcon.
#
# clk_ignore_unused stays mandatory - it is what keeps U-Boot's display clocks
# alive so the simple-framebuffer console survives late_initcall.
CONFIG_CMDLINE="console=ttyS0,115200 console=tty0 earlycon clk_ignore_unused pd_ignore_unused root=/dev/mmcblk0p5 rootfstype=ext4 rootwait rw fbcon=font:TER16x32"
CONFIG_CMDLINE_EXTEND=n
CONFIG_CMDLINE_FORCE=y
CONFIG_KERNEL_GZIP=n
CONFIG_KERNEL_XZ=y
CONFIG_DEBUG_INFO_NONE=y

# multi_v7_defconfig is the baseline, but this image targets only sunxi ARMv7.
CONFIG_ARCH_VIRT=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_HPE=n
CONFIG_ARCH_SUNPLUS=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_ARTPEC=n
CONFIG_ARCH_ASPEED=n
CONFIG_ARCH_MICROCHIP=n
CONFIG_ARCH_AT91=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_DIGICOLOR=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_HIGHBANK=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_KEYSTONE=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MILBEAUT=n
CONFIG_ARCH_MMP=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_OMAP2PLUS=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_SPEAR13XX=n
CONFIG_ARCH_STI=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_U8500=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VT8500=n
CONFIG_ARCH_ZYNQ=n

# Essential pseudo filesystems and root filesystem
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEVMEM=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

# Modules and firmware
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=n
CONFIG_FW_LOADER=y
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH="/sbin/mdev"

# SD boot medium
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SUNXI=y

# The regulator framework is REQUIRED for MMC, and not for the reason it looks.
#
# With CONFIG_REGULATOR=n the card was rejected before it ever transferred data:
#     sunxi-mmc 4020000.mmc: no support for card's volts
#     mmc0: error -22 whilst initialising SD card
#     mmc0: Failed to initialize a non-removable card
#
# mmc_select_voltage() does "ocr &= host->ocr_avail" and warns when nothing
# overlaps. host->ocr_avail is populated by mmc_regulator_get_supply() from
# vmmc-supply = <&reg_vcc3v3>, which is a stub when the regulator framework is
# absent - so ocr_avail stayed empty and no card voltage could ever match.
#
# Both regulator-fixed nodes are regulator-always-on with no enable GPIO, so
# nothing is starved of *power* without this. That reasoning was used earlier to
# dismiss REGULATOR and was wrong: the regulator's other job here is supplying
# the OCR voltage mask, which is pure software.
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# USB keyboard. USB enumerates fine (hubs and ports are detected) but without a
# HID stack nothing ever claims the device, so keypresses go nowhere. The VT
# keyboard handler in drivers/tty/vt/keyboard.c comes with CONFIG_VT and binds
# through the input layer, so HID + INPUT is all that is missing.
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_KEYBOARD=y

# reboot. On sunxi the watchdog *is* the reset mechanism: without sunxi_wdt the
# kernel registers no restart handler at all and `reboot` cannot do anything.
#
# This was enabled once before and appeared to hang early boot, so it was backed
# out. That test happened while the misaligned framebuffer reservation was
# making every probe fail silently, so the result is not trustworthy and is
# worth re-running now that the system is healthy. If the board hangs before the
# console appears, this is the first thing to revert.
#
# poweroff cannot be fixed in software: the board has no PMIC and no
# software-controlled power rail, so halting is the correct outcome and
# unplugging is the only real power-off.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_SUNXI_WATCHDOG=y

# Userspace ABI that allnoconfig drops. All of these are "default y" upstream and
# are only hideable under EXPERT, so nothing warned when they vanished.
#
# COMPAT_32BIT_TIME provides the legacy 32-bit settimeofday/gettimeofday on
# 32-bit ARM. Without it swclock reported:
#     swclock: settimeofday: Function not implemented
# ENOSYS - so the clock could never be set, every mtime looked skewed, and
# openrc rebuilt its dependency cache on *every* service start. That is the
# "Caching service dependencies ..." spam that ate ~10 s of every boot.
CONFIG_COMPAT_32BIT_TIME=y

# INOTIFY_USER is why X had no keyboard or mouse. udevd dies at startup with
#     udevd: inotify_init failed: Function not implemented
#     udevd: error initializing inotify
# so /dev/input is never populated, and Xorg reports
#     "The server relies on udev to provide the list of input devices."
# The X-side fixes (xkbcomp, libinput, InputClass rules) could never have worked;
# the failure was three layers below them.
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_DNOTIFY=y

# openrc runs a cgroups service in sysinit and expects these.
CONFIG_CGROUPS=y
CONFIG_SECCOMP=y

# Individual namespace types. CONFIG_NAMESPACES=y alone is not enough and this
# is easy to miss: the earlier audit checked NAMESPACES, saw it set, and moved
# on while USER_NS/PID_NS/UTS_NS were all off.
#
# WebKitGTK sandboxes its web process with bubblewrap, which fails without them:
#     bwrap: Creating new namespace failed: Invalid argument
#     ERROR: readPIDFromPeer: Unexpected short read from PID socket
# and the browser aborts. Also required by anything container-ish.
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y

# zram: compressed swap in RAM. On a 243 MiB board this is worth far more than
# the SD-backed swapfile - roughly 2-3x effective capacity at memory speed, with
# no flash wear. zstd compresses better than lzo at similar cost here.
#
# BLK_DEV is required even though ZRAM's own "depends on" line does not mention
# it: ZRAM sits inside the `if BLK_DEV` menu in drivers/block/Kconfig, so the
# menu nesting adds an implicit dependency. Without it CONFIG_ZRAM=y is silently
# dropped by olddefconfig.
#
# ZSMALLOC is deliberately NOT listed: it is a promptless tristate that ZRAM
# selects, so setting it by hand has no effect.
CONFIG_BLK_DEV=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZO=y

# Alpine's /etc/apk and several tools expect xattr/ACL support on tmpfs.
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# `ss` and friends need the sock_diag modules to report anything useful.
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y
CONFIG_INET_DIAG=y

# Embed the config in the kernel so /proc/config.gz exists. Five separate bugs
# in this project were "allnoconfig silently dropped a default-y symbol"
# (REGULATOR, HID, WATCHDOG, COMPAT_32BIT_TIME, INOTIFY_USER). Being able to
# audit the running kernel's config from the device itself makes the next one a
# one-line check instead of a multi-boot hunt.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Xorg's MIT-SHM extension needs SysV shared memory. Without it X falls back to
# slow transport at best.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Timestamps in dmesg - the 11 s deferred-probe delay before MMC still needs
# explaining, and this is how it gets measured.
CONFIG_PRINTK_TIME=y

# Real RTC. The SoC has one at rtc@7090000; sun6i-rtc covers the D1/T113 family.
# Probably not battery-backed on this board, so it will not survive unplugging,
# but it gives /dev/rtc0 so hwclock works within a session.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_SUN6I=y

# WiFi: RTL8188ETV (0bda:0179) on the internal USB host.
#
# The vendor 8188eu.ko was built against 5.4.61 and will not load here, but
# mainline needs no out-of-tree driver at all. drivers/net/wireless/realtek/
# rtl8xxxu/core.c:8066 carries our exact device:
#
#     /* Tested by Hans de Goede - rtl8188etv */
#     {USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_REALTEK, 0x0179, ...),
#             .driver_info = (unsigned long)&rtl8188eu_fops},
#
# It is a *tested* entry, so CONFIG_RTL8XXXU_UNTESTED is not required.
# rtl8xxxu is a mac80211 driver and Kconfig demands MAC80211 && USB &&
# LEDS_CLASS; only MAC80211 was missing.
#
# Firmware "rtlwifi/rtl8188eufw.bin" must exist on the rootfs
# (Alpine: linux-firmware-rtlwifi).
CONFIG_MAC80211=m
CONFIG_RTL8XXXU=m

# WPA2/WPA3 ciphers. mac80211 selects most of these, but pinning them means a
# future allnoconfig pass cannot quietly drop them the way it did REGULATOR,
# HID, WATCHDOG and COMPAT_32BIT_TIME.
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_ARC4=y

# Allwinner serial console
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# USB host and PHY are built in so networking can enumerate immediately
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DEFAULT_PERSIST=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_GENERIC_PHY=y
CONFIG_RESET_CONTROLLER=y
CONFIG_EXTCON=y
CONFIG_POWER_SUPPLY=y
CONFIG_PHY_SUN4I_USB=y

# Networking core and the cfg80211 API required by the existing 8188eu driver
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IP_PNP=n
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_RFKILL=y
CONFIG_WLAN=y

# Emergency USB Ethernet adapters (modules)
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_ASIX=m
CONFIG_USB_NET_AX88179_178A=m
# Disabled: r8152 drives Realtek USB *Ethernet* adapters, which this board
# does not have - networking is the RTL8188EU WiFi dongle via rtl8xxxu. Worse,
# it registers a choose_configuration callback that runs against every USB
# device being probed, and it NULL-derefs on unrelated ones:
#
#   Internal error: Oops: 5 [#1] SMP THUMB2
#   PC is at rtl8152_cfgselector_choose_configuration+0x16/0x3c [r8152]
#   Comm: udevd   Register r2 information: NULL pointer
#
# The oops kills the udevd worker, which is why udev-settle used to hang and
# 'worker ... is taking a long time' appeared. Captured on video 2026-08-20.
CONFIG_USB_RTL8152=n

# Small but useful recovery input support
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Status LED
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# Console on HDMI without an HDMI driver.
#
# U-Boot has already initialised the display - that is how the Tux bootlogo
# appears - and the running vendor system reported exactly where it lives:
#     disp_reserve=3686400,0x4bee8c00
#     boot_fb0 = "4bee8c00,500,2d0,20,1400"  -> 1280x720, 32bpp, stride 5120
# 3686400 == 1280*720*4, so simple-framebuffer can just take it over. This is
# the only console available on this board without a UART adapter.
#
# clk_ignore_unused is mandatory alongside it: without a display driver nothing
# claims the DE/TCON/HDMI clocks U-Boot left running, and the clock framework
# culls them at late_initcall - which is exactly what makes Tux vanish.
# Address confirmed by the v41 chunk search: the framebuffer really is at
# 0x4bee8c00. The earlier failures were a misaligned no-map reservation, not a
# wrong address, so the console can be turned back on.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_DEVICE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_SUPPORT=y
# DRM sets the display's preferred mode - 1920x1080 here - rather than the
# 1280x720 U-Boot left for simplefb, so the 8x16 font that gave a 160x45 console
# now gives 240x67 and glyphs 1.5x smaller. Terminus 16x32 restores a readable
# size (120x33, actually larger than the original) without giving up the mode.
#
# FONT_TER16x32 needs FONTS=y, and turning FONTS on cancels FONT_8x16's
# "default y if !FONTS" - so 8x16 has to be requested explicitly to stay as a
# fallback for anything that cannot use 16x32.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# Display: DRM/KMS via the ported D1/T113 HDMI PHY, with simplefb kept as a
# fallback. FB_SIMPLE depends only on !DRM_SIMPLEDRM, not on !DRM, so the two
# can coexist: if sun4i-drm binds it calls aperture_remove_all_conflicting_devices()
# and takes the console over via fbdev emulation; if it fails to probe, simplefb
# survives and the HDMI console still works. That is the whole reason
# DRM_SIMPLEDRM is pinned off rather than just left at its default.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=n
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_DRM_DW_HDMI=y
# A10-era HDMI controller and the original (non-DE2) backend - wrong hardware,
# and they default to y once DRM_SUN4I is on.
CONFIG_DRM_SUN4I_HDMI=n
CONFIG_DRM_SUN4I_BACKEND=n
CONFIG_DRM_SUN6I_DSI=n

# The DE2 mixer scans out of contiguous buffers. 1280x720x4 is 3.5 MB per
# buffer; 32 MB leaves room for double buffering plus a cursor without being
# reckless on a 256 MB board. CMA pages stay available to the page allocator
# for movable allocations while the display is not using them.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
# 32 MB was too small: at 1920x1080 each buffer is 8.3 MB, DRM's fbdev console
# holds one, and a video player wanting double buffering needs two more. That
# totals ~25 MB before fragmentation, so mpv failed with
# "Cannot create dumb buffer: Out of memory" once anything else had run.
# CMA pages stay available to the page allocator for movable allocations while
# the display is not using them, so this is reserved rather than consumed.
CONFIG_CMA_SIZE_MBYTES=64

# Build in ARM state, not Thumb-2.
#
# With CONFIG_THUMB2_KERNEL=y, &secondary_startup carries the Thumb bit, so
# psci_boot_secondary() hands the firmware an odd entry point - observed as
# "cpu_on(mpidr=0x1, entry=0x40108009) returned 0". The call succeeds and CPU1
# never comes online, which is what a core faulting on its first instruction
# looks like.
#
# The PSCI spec says bit 0 selects instruction set state on AArch32, but this
# board's PSCI lives in vendor firmware that was only ever exercised by
# Allwinner's own ARM-mode 5.4 kernel, so Thumb entry is likely untested.
# Building ARM makes the entry point even and sidesteps the question.
CONFIG_THUMB2_KERNEL=n

# maxcpus=1 used to be set above as a control. It was removed in v69: it did not
# isolate the fault, it hid it. v60's "ARM mode is unstable with two cores" was
# the vendor firmware leaving CNTVOFF uninitialised on CPU1, and the symptom only
# appears with both cores up - so the control suppressed the only condition that
# could reveal it. The fix is arm,cpu-registers-not-fw-configured in the DTS.

# Crash logging. Without a UART, a hang destroys its own evidence. ramoops keeps
# the log across a reboot in /sys/fs/pstore; the lockup detectors print a
# backtrace before the machine dies rather than after.
# PSTORE lives inside the MISC_FILESYSTEMS menu and the lockup detectors depend
# on DEBUG_KERNEL. Without these two gates, merge_config silently drops every
# symbol below - the same failure mode as the allnoconfig casualties.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_DEBUG_KERNEL=y
# Both cores come up at boot and are stable under load, so nothing needs to
# offline a CPU at runtime - and offlining one is actively dangerous here. The
# vendor firmware's PSCI can start a core but cannot cleanly stop one: writing 0
# to /sys/devices/system/cpu/cpu1/online hangs the machine hard, needing a power
# cycle. Disabling hotplug makes that CPU_OFF path unreachable rather than
# merely unused.
CONFIG_HOTPLUG_CPU=n
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# Explicitly defer nonessential subsystems
# HDMI audio. dw-hdmi only registers its I2S codec if the HDMI TX was
# synthesised with the I2S option (HDMI_CONFIG0_I2S in the CONFIG0_ID register);
# the vendor DT drives audio exactly this way, so it should be present, but if
# no hdmi-audio-codec device appears that bit is the thing to check.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN4I_I2S=y
# The i2s controller is fed by the DMA engine, and DMADEVICES is another
# allnoconfig casualty - nothing had needed DMA until audio arrived. Without it
# sun4i-i2s fails with "Missing dma channel for stream: 0" and the whole sound
# card probe unwinds with -22.
CONFIG_DMADEVICES=y
CONFIG_DMA_SUN6I=y

# Diagnostics. HDMI audio reaches the sink as digital silence with every
# sysfs-visible layer reporting success, so the registers have to be read back
# directly: /sys/kernel/debug/regmap/2034000.i2s/registers shows whether HUB_EN
# (bit 31 of 0x14) is really set during playback, /sys/kernel/debug/asoc shows
# DAPM, and clk_summary shows whether the i2s clocks are running at all.
# clk_summary also finally answers what the CPU is clocked at.
CONFIG_DEBUG_FS=y
CONFIG_COMMON_CLK_DEBUG=y

# Recovery. sysrq over /proc/sysrq-trigger gives sync + remount-ro before a hard
# power cycle, and "w" dumps D-state tasks - which is what the udev-settle hang
# needed. PANIC_TIMEOUT was 0, meaning a panic hung forever; only worth changing
# now that v56 gave the board a working restart handler.
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_SND_SIMPLE_CARD=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
CONFIG_BT=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_VIDEO_DEV=n
CONFIG_RC_CORE=n
CONFIG_STAGING_MEDIA=n
CONFIG_DVB_CORE=n
CONFIG_WWAN=n
CONFIG_WIMAX=n
CONFIG_NFC=n
