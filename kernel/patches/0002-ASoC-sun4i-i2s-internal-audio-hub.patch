ASoC: sun4i-i2s: support routing TX into the internal audio hub

On the T113 the I2S controller that feeds HDMI does not send data out to
the I2S pins - those are not connected on an HDMI-only board - but into
the SoC's internal audio hub, which is what the HDMI controller reads.
That routing is a single bit, HUB_EN, in the FIFO control register.

Mainline sun4i-i2s has no concept of it, so playback appears to succeed
and produces silence: the PCM runs, the FIFO drains, and the samples go
to unconnected pins.

The vendor driver calls the same register SUNXI_DAUDIO_FIFOCTL (0x14,
identical to SUN4I_I2S_FIFO_CTRL_REG) and the same bit HUB_EN (31, unused
by mainline), and sunxi_daudio_set_hub_mode() enables it alongside TXEN -
which start_playback already sets. The vendor DT marks the relevant node
with tx-hub-en and dai-type = "hdmi".

Gated on an "allwinner,tx-hub-en" property so boards using real I2S pins
are unaffected.

Not-Signed-off-by: nobody, this is a downstream hack
---
--- a/sound/soc/sunxi/sun4i-i2s.c	2026-08-20 17:20:21.868304813 +0200
+++ b/sound/soc/sunxi/sun4i-i2s.c	2026-08-20 17:20:21.869253208 +0200
@@ -55,6 +55,7 @@
 #define SUN4I_I2S_FIFO_RX_REG		0x10
 
 #define SUN4I_I2S_FIFO_CTRL_REG		0x14
+#define SUN4I_I2S_FIFO_CTRL_HUB_EN		BIT(31)
 #define SUN4I_I2S_FIFO_CTRL_FLUSH_TX		BIT(25)
 #define SUN4I_I2S_FIFO_CTRL_FLUSH_RX		BIT(24)
 #define SUN4I_I2S_FIFO_CTRL_TX_MODE_MASK	BIT(2)
@@ -228,6 +229,14 @@
 	struct regmap_field	*field_fmt_sr;
 
 	const struct sun4i_i2s_quirks	*variant;
+
+	/*
+	 * Route the TX FIFO into the SoC's internal audio hub instead of
+	 * out to the I2S pins. On the T113 this is how audio reaches the
+	 * HDMI controller; the vendor DT marks the same node tx-hub-en
+	 * with dai-type = "hdmi".
+	 */
+	bool				tx_hub_en;
 };
 
 struct sun4i_i2s_clk_div {
@@ -990,6 +999,15 @@
 	/* Clear TX counter */
 	regmap_write(i2s->regmap, SUN4I_I2S_TX_CNT_REG, 0);
 
+	/*
+	 * Enable the audio hub before the TX block, matching the vendor
+	 * driver's ordering in sunxi_daudio_set_hub_mode().
+	 */
+	if (i2s->tx_hub_en)
+		regmap_update_bits(i2s->regmap, SUN4I_I2S_FIFO_CTRL_REG,
+				   SUN4I_I2S_FIFO_CTRL_HUB_EN,
+				   SUN4I_I2S_FIFO_CTRL_HUB_EN);
+
 	/* Enable TX Block */
 	regmap_update_bits(i2s->regmap, SUN4I_I2S_CTRL_REG,
 			   SUN4I_I2S_CTRL_TX_EN,
@@ -1025,6 +1043,10 @@
 	regmap_update_bits(i2s->regmap, SUN4I_I2S_DMA_INT_CTRL_REG,
 			   SUN4I_I2S_DMA_INT_CTRL_TX_DRQ_EN,
 			   0);
+
+	if (i2s->tx_hub_en)
+		regmap_update_bits(i2s->regmap, SUN4I_I2S_FIFO_CTRL_REG,
+				   SUN4I_I2S_FIFO_CTRL_HUB_EN, 0);
 }
 
 static int sun4i_i2s_trigger(struct snd_pcm_substream *substream, int cmd,
@@ -1544,6 +1566,8 @@
 		return irq;
 
 	i2s->variant = of_device_get_match_data(&pdev->dev);
+	i2s->tx_hub_en = of_property_read_bool(pdev->dev.of_node,
+					       "allwinner,tx-hub-en");
 	if (!i2s->variant) {
 		dev_err(&pdev->dev, "Failed to determine the quirks to use\n");
 		return -ENODEV;
